        </mxCell>

        <!-- Stage 2: source and transport branches -->
        <mxCell id="poll-source" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;정기 수집 대상&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Security S3&lt;/b&gt; · ALB Access Log&lt;/div&gt;&lt;div&gt;&lt;b&gt;CloudWatch Logs&lt;/b&gt; · CloudTrail · WAF · DVWA · CloudFront&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5B6573;&quot;&gt;CloudTrail S3 사본은 장기 보관·Athena 재분석용이며 Wazuh 입력과 중복 수집하지 않음&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4FAEA;strokeColor=#6B9D1A;strokeWidth=2.5;fontColor=#232F3E;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="292" width="500" height="142" as="geometry"/>
        </mxCell>
        <mxCell id="push-source" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;DVWA Audit Event Hot Copy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;event_type · result · route · take_id · pod_name · pod_uid&lt;/div&gt;&lt;div&gt;context.action · resource · security_level · stage · status&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#8A3B67;&quot;&gt;명령 원문·응답·Credential·Cookie 제거 · 승인 필드와 해시만 사용&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2F8;strokeColor=#E7157B;strokeWidth=2.5;fontColor=#232F3E;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="292" width="500" height="142" as="geometry"/>
        </mxCell>
        <mxCell id="poll-transport" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;Wazuh AWS Module · 5분 Polling&lt;/b&gt;&lt;/div&gt;&lt;div&gt;S3와 CloudWatch Logs를 하나의 주기로 조회&lt;/div&gt;&lt;div style=&quot;font-size:12px;&quot;&gt;넓은 Source 범위 · 장기 조사와 후속 확인 · Rule 100111 입력&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FBEF;strokeColor=#6B9D1A;strokeWidth=2.5;fontColor=#232F3E;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="474" width="500" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="push-transport" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;DVWA Audit Event 저지연 전달&lt;/b&gt;&lt;/div&gt;&lt;div&gt;CloudWatch Logs Subscription → Lambda → SQS → Local Bridge&lt;/div&gt;&lt;div style=&quot;font-size:12px;&quot;&gt;Rule 100102 건전성 Event · Rule 100110 공격 Event 입력&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2F8;strokeColor=#E7157B;strokeWidth=2.5;fontColor=#232F3E;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="474" width="500" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="transport-note" value="같은 DVWA Audit Event는 정기 수집 대상에도 포함되지만, 저지연 경로에서는 Lambda·SQS·Local Bridge를 통해 먼저 전달될 수 있음" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontColor=#475569;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
