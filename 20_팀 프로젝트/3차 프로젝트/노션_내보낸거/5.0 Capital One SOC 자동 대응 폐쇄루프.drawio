        <!-- Stage 1: attack -->
        <mxCell id="attack-flow" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;사용자 요청 → CloudFront·WAF → DVWA Command Injection → EC2 IMDS Node Role Credential → 보호 S3 Object GetObject&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#5B6573;margin-top:6px;&quot;&gt;개인정보가 아닌 고정 검증 객체 validation/capital-one-demo.csv 사용 · Credential 원문은 출력·로그·증적에 저장하지 않음&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0073BB;strokeWidth=3;fontColor=#232F3E;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
