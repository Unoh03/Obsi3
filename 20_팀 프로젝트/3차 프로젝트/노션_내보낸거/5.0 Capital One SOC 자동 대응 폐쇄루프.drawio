        <!-- Stage 3: Wazuh and rule branches -->
        <mxCell id="wazuh-hub" value="&lt;div style=&quot;font-size:21px;&quot;&gt;&lt;b&gt;Wazuh SIEM&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Manager · Decoder · Custom Rule · Indexer · Dashboard&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;CloudFront · WAF · ALB · DVWA · CloudTrail 중앙 수집·조회 · Alert 생성 · Incident Timeline 조사 지원&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C45500;strokeWidth=3;fontColor=#232F3E;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
