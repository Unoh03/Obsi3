          <mxGeometry x="280" y="338" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p1-path-label-right" value="저지연·선별 경로" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#B80F62;fontStyle=1;" vertex="1" parent="p1-1">
