        <mxCell id="p2-argo110" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;Argo CD → EKS 자동 동기화&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Quarantine Job이 실제 UID·Label·ReplicaSet·Deployment Owner 관계를 다시 검증&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF7FF;strokeColor=#0073BB;strokeWidth=3;fontColor=#17365D;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p2-1">
          <mxGeometry x="330" y="982" width="360" height="100" as="geometry"/>
