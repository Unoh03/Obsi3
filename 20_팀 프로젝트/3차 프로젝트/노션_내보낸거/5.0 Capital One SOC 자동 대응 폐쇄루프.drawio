        <mxCell id="p1-wazuh" value="&lt;div style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;Wazuh SIEM&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Manager · Decoder · Custom Rule · Indexer · Dashboard&lt;/div&gt;&lt;div style=&quot;font-size:13px;&quot;&gt;CloudFront · WAF · ALB · DVWA · CloudTrail 중앙 수집·조회 · Alert 생성 · Incident Timeline 조사 지원&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C45500;strokeWidth=3;fontColor=#232F3E;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="p1-1">
          <mxGeometry x="170" y="1010" width="1060" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="p1-rule102" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Rule 100102 · Level 3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;전달 경로 건전성 확인&lt;/div&gt;&lt;div style=&quot;font-size:12px;&quot;&gt;transport=push · source=dvwa&lt;br&gt;wazuh.push.validation · SAFE_VALIDATION_EVENT&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5B6573;&quot;&gt;공격 Alert가 아니며 자동 대응 없음&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2.5;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p1-1">
          <mxGeometry x="170" y="1200" width="300" height="166" as="geometry"/>
        </mxCell>
        <mxCell id="p1-rule110" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Rule 100110 · Level 12&lt;/b&gt;&lt;/div&gt;&lt;div&gt;DVWA IMDS Credential endpoint 출력 반환&lt;/div&gt;&lt;div style=&quot;font-size:12px;&quot;&gt;push · low · imds_credential_fetch&lt;br&gt;output_returned · /vulnerabilities/exec/&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#8A3B67;&quot;&gt;공격 전 차단이 아니라 100111보다 먼저 대응을 시작하는 저지연 Alert&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2F8;strokeColor=#E7157B;strokeWidth=3;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p1-1">
          <mxGeometry x="550" y="1200" width="300" height="166" as="geometry"/>
        </mxCell>
        <mxCell id="p1-rule111" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Rule 100111 · Level 14&lt;/b&gt;&lt;/div&gt;&lt;div&gt;보호 S3 Object 실제 바이트 반환&lt;/div&gt;&lt;div style=&quot;font-size:12px;&quot;&gt;GetObject · AssumedRole · HTTP 200&lt;br&gt;bytesTransferredOut &gt; 0&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#824900;&quot;&gt;고정 Account·Region·Role·Bucket·Object를 모두 확인하는 고신뢰 Alert&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C45500;strokeWidth=3;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="1200" width="300" height="166" as="geometry"/>
        </mxCell>
        <mxCell id="p1-monitor" value="&lt;b&gt;Dashboard 상태 확인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;&quot;&gt;Count·최근 Validation Event&lt;br&gt;자동 대응 없음&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="p1-1">
          <mxGeometry x="170" y="1418" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="p1-alert110" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Wazuh Alert · Rule 100110&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Alert ID · 발생 시각 · take_id · Pod name·UID · 원문 SHA-256&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#8A3B67;&quot;&gt;다음 페이지의 로컬 검증·Shuffle 대응 입력&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF9FC;strokeColor=#E7157B;strokeWidth=3;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p1-1">
          <mxGeometry x="520" y="1418" width="360" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p1-alert111" value="&lt;div style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Wazuh Alert · Rule 100111&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Alert ID · 발생 시각 · CloudTrail eventID · 원문 SHA-256&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#824900;&quot;&gt;다음 페이지의 원문 검증·Shuffle 대응 입력&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFAF5;strokeColor=#C45500;strokeWidth=3;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="p1-1">
          <mxGeometry x="900" y="1418" width="360" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p1-timeline" value="&lt;div style=&quot;font-size:17px;&quot;&gt;&lt;b&gt;관제자 Incident Timeline 조사&lt;/b&gt;&lt;/div&gt;&lt;div&gt;100110과 100111은 서로를 전제하지 않는 독립 Alert이다. 시각·take_id·Pod·IAM Role·S3 Object를 비교해 동일 사건 여부를 판단한다.&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;&quot;&gt;탐지 지연 차이 때문에 Dashboard에는 100110이 먼저, 100111이 나중에 나타날 수 있다.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#334155;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="270" y="1600" width="860" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="p1-next" value="다음 페이지 입력: 검증된 Wazuh Rule 100110 / 100111 Alert" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="p1-1">
          <mxGeometry x="410" y="1760" width="580" height="48" as="geometry"/>
